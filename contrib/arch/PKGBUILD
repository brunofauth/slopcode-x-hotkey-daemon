pkgbase=sxhkd-git
pkgname=('sxhkd-git' 'sxhkd-indicator-git')
pkgver=0.7.3.r1.gdfe5e49
pkgrel=1
pkgdesc='Simple X hotkey daemon, with an on-screen chord-chain indicator'
arch=('x86_64' 'aarch64')
url='https://github.com/brunofauth/slopcode-x-hotkey-daemon'
license=('GPL-3.0-or-later' 'BSD-2-Clause')
# One build makes both programs, so it needs the libraries of both; what each
# package needs at run time is listed in its package function. makepkg only
# installs the arrays of the PKGBUILD itself, hence the run-time libraries
# here too. xcb-util only provides xcb/xcb_event.h (macros); nothing links
# libxcb-util.
makedepends=('git' 'pkgconf' 'libxcb' 'xcb-util' 'xcb-util-keysyms' 'cairo' 'pango')
# By default this builds the repository the PKGBUILD lives in, so nothing has
# to be pushed anywhere; set SXHKD_GIT_URL (for instance to "$url.git") to
# build another clone instead.
_repository_url="${SXHKD_GIT_URL:-file://$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)}"
source=("sxhkd::git+${_repository_url}")
sha256sums=('SKIP')

pkgver() {
	cd sxhkd
	git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cd sxhkd
	make
}

check() {
	cd sxhkd
	# UBSan only: no -Werror (compiler-version dependent) and no ASan
	# (needs libasan and fights the hardening flags of some toolchains).
	make check TEST_CFLAGS=-fsanitize=undefined
}

package_sxhkd-git() {
	pkgdesc='Simple X hotkey daemon'
	depends=('libxcb' 'xcb-util-keysyms')
	provides=('sxhkd')
	conflicts=('sxhkd')

	cd sxhkd
	make PREFIX=/usr DESTDIR="$pkgdir" PROGRAMS=sxhkd install
	install -Dm644 LICENSE LICENSE.BSD-2-Clause -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_sxhkd-indicator-git() {
	pkgdesc='On-screen chord-chain indicator for sxhkd, reading its status FIFO'
	# The indicator links libxcb itself; the drawing libraries are its own.
	depends=('sxhkd-git' 'libxcb' 'cairo' 'pango')
	provides=('sxhkd-indicator')
	conflicts=('sxhkd-indicator')

	cd sxhkd
	make PREFIX=/usr DESTDIR="$pkgdir" PROGRAMS=sxhkd-indicator install
	install -Dm644 LICENSE LICENSE.BSD-2-Clause -t "$pkgdir/usr/share/licenses/$pkgname"
}
